rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Kiểm tra quyền Admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Kiểm tra Đăng nhập
    function isAuth() {
      return request.auth != null;
    }
    
    function isValidAmount(amount) {
      return amount is number && amount >= 0;
    }

    match /users/{userId} {
      // User chỉ có thể xem profile của chính mình. Admin xem được tất cả
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      // Chỉ Admin mới có quyền tạo/sửa/xóa user (ngăn tự thăng cấp)
      allow write: if isAdmin();
    }

    match /students/{document=**} {
      allow read: if isAuth();
      // Admin có toàn quyền. User chỉ có quyền tạo mới hoặc cập nhật (không xóa)
      allow create: if isAuth() 
        && request.resource.data.keys().hasOnly(['fullName', 'parentPhone', 'dob', 'school', 'referrer', 'status', 'subjects', 'createdAt', 'updatedAt', 'version'])
        && request.resource.data.version == 1;

      allow update: if isAuth() 
        && request.resource.data.keys().hasOnly(['fullName', 'parentPhone', 'dob', 'school', 'referrer', 'status', 'subjects', 'createdAt', 'updatedAt', 'version'])
        && (
          (!('version' in resource.data) && request.resource.data.version == 1)
          || (('version' in resource.data) && request.resource.data.version == resource.data.version + 1)
        );

      allow delete: if isAdmin();
    }
    
    match /tuition/{document=**} {
      allow read: if isAuth();
      // Đảm bảo không truyền lên feeAmount âm và chặn Mass Assignment
      allow create, update: if isAuth() 
        && request.resource.data.keys().hasOnly(['studentId', 'month', 'feeAmount', 'paidAmount', 'status', 'paymentDate', 'paymentMethod', 'notes', 'subjectBreakdown'])
        && (!request.resource.data.keys().hasAny(['feeAmount']) || isValidAmount(request.resource.data.feeAmount))
        && (!request.resource.data.keys().hasAny(['paidAmount']) || isValidAmount(request.resource.data.paidAmount));
      allow delete: if isAdmin();
    }

    match /settings/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    match /teachers/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    match /subjects/{document=**} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
